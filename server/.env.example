# Port the game server listens on.
PORT=2567

# Optional: an OpenAI-compatible endpoint for the AI player's chat.
# Leave blank and the AI uses a few built-in lines.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: play the mini-games in this order instead of shuffled, e.g. to test one.
# Names: red-light-green-light, glass-bridge-memory, pick-a-side, prompt-podium
MINI_GAMES=
